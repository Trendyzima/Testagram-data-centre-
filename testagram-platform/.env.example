# Testagram-owned runtime settings. Copy outside source control; never commit real secrets.
TESTAGRAM_PLATFORM_ROOT=/var/lib/testagram/supabase # compatibility default; change only with an explicit migration
TESTAGRAM_PLATFORM_URL=https://api.testagram.site
TESTAGRAM_STORAGE_ROOT=/var/lib/testagram/storage
# Upstream-compatible environment key; API is exposed through Testagram's domain.
TESTAGRAM_PUBLIC_URL=https://api.testagram.site
SUPABASE_PUBLIC_URL=https://api.testagram.site
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ANON_KEY=REPLACE_WITH_A_SIGNED_JWT
SERVICE_ROLE_KEY=REPLACE_WITH_A_SIGNED_SERVICE_ROLE_JWT
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
