# Copy the POSTGRES_PASSWORD value from the Backend self-hosted .env.
# The Backend Compose stack creates the stable testagram-platform network first.
DATABASE_URL=postgresql://testagram:REPLACE_WITH_SAME_BACKEND_POSTGRES_PASSWORD@postgres:5432/testagram?sslmode=disable
TESTAGRAM_NETWORK=testagram-platform
# Join the Backend's private Caddy edge network so /v1/video routes stay HTTPS-only.
TESTAGRAM_EDGE_NETWORK=testagram-self-hosted_edge
TESTAGRAM_EGRESS_NETWORK=testagram-egress

# Immutable container tags published by the matching repositories.
# Update these only after the corresponding repository's container workflow passes.
TESTAGRAM_ALGORITHM_IMAGE=ghcr.io/trendyzima/testagram-feed:sha-ca585b7fe40cb423d1c5d2f32eb8930ee9558949
TESTAGRAM_FEDERATION_IMAGE=ghcr.io/trendyzima/testagram-federation:sha-8aa46c04532eab99d533709109c7f86d716cff36
ALGORITHM_INTERNAL_TOKEN=REPLACE_WITH_SHARED_RANDOM_32_BYTE_RANKER_TOKEN
FEDERATION_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_BACKEND_TO_FEDERATION_TOKEN
FEDERATION_BACKEND_INTERNAL_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_32_BYTE_FEDERATION_TO_BACKEND_TOKEN
FEDERATION_DATABASE_NAME=testagram_federation
FEDERATION_DATABASE_URL=postgresql://testagram:REPLACE_WITH_SAME_BACKEND_POSTGRES_PASSWORD@federation-db:5432/testagram_federation?sslmode=disable
FEDERATION_PUBLIC_BASE_URL=https://testagram.site
FEDERATION_INSTANCE_DOMAIN=testagram.site
FEDERATION_SERVICE_ACTOR_USERNAME=testagram
FEDERATION_DELIVERY_WORKER_ENABLED=false
FEDERATION_OUTBOX_POLLER_ENABLED=false
FEDERATION_INBOX_WORKER_ENABLED=false

# End-user services accept only short-lived Testagram-native HS256 access tokens.
# This must exactly match TESTAGRAM_AUTH_JWT_SECRET in the Backend .env.
TESTAGRAM_AUTH_JWT_SECRET=REPLACE_WITH_THE_SAME_BACKEND_NATIVE_AUTH_SECRET

VIDEO_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
VIDEO_ACCOUNT_QUOTA_BYTES=21474836480
VIDEO_MIN_FREE_BYTES=2147483648

NOTIFICATION_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET
PLATFORM_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET

# Persistent media root shared by the video API and worker.
TESTAGRAM_STORAGE_ROOT=/var/lib/testagram/storage

# Optional dedicated media lifecycle profile.
# B2 is the media-byte primary and R2 is its verified replica. MinIO below
# stores metadata sidecars only; it is NOT a third media-byte replica.
# Keep this profile off until dedicated non-production B2/R2 buckets pass
# backend/services/media/provider_smoke_test.go and the Backend/CDN gates.
FRESH_DATA_CENTRE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_MEDIA_SERVICE_TOKEN
MEDIA_DATABASE_NAME=testagram_media
MEDIA_DATABASE_URL=postgresql://testagram:REPLACE_WITH_SAME_BACKEND_POSTGRES_PASSWORD@postgres:5432/testagram_media?sslmode=disable

B2_S3_ENDPOINT=https://s3.REGION.backblazeb2.com
B2_S3_REGION=REGION
B2_S3_BUCKET=testagram-media-staging-b2
B2_S3_ACCESS_KEY_ID=REPLACE_WITH_B2_STAGING_ACCESS_KEY
B2_S3_SECRET_ACCESS_KEY=REPLACE_WITH_B2_STAGING_SECRET

CLOUDFLARE_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=testagram-media-staging-r2
CLOUDFLARE_R2_ACCESS_KEY_ID=REPLACE_WITH_R2_STAGING_ACCESS_KEY
CLOUDFLARE_R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_STAGING_SECRET

# The MinIO metadata credentials must be the dedicated metadata-only identity
# created by the Backend object-init job, not the MinIO root credentials.
VPS_MINIO_ENDPOINT=http://object-storage:9000
VPS_MINIO_REGION=us-east-1
VPS_MINIO_METADATA_BUCKET=testagram-media-metadata
VPS_MINIO_METADATA_ACCESS_KEY_ID=REPLACE_WITH_BACKEND_MINIO_METADATA_ACCESS_KEY
VPS_MINIO_METADATA_SECRET_ACCESS_KEY=REPLACE_WITH_BACKEND_MINIO_METADATA_SECRET
CLOUDFLARE_R2_METADATA_BUCKET=testagram-media-staging-metadata
# Public inbound ActivityPub POST is fail-closed until the durable workers pass peer acceptance.
FEDERATION_INBOX_ACCEPT_ENABLED=false
