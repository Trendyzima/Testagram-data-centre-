# Copy the POSTGRES_PASSWORD value from the Backend self-hosted .env.
# The Backend Compose stack creates the stable testagram-platform network first.
DATABASE_URL=postgresql://testagram:REPLACE_WITH_SAME_BACKEND_POSTGRES_PASSWORD@postgres:5432/testagram?sslmode=disable
TESTAGRAM_NETWORK=testagram-platform
TESTAGRAM_EGRESS_NETWORK=testagram-egress

# Immutable container tags published by the matching repositories.
# Update these only after the corresponding repository's container workflow passes.
TESTAGRAM_ALGORITHM_IMAGE=ghcr.io/trendyzima/testagram-feed:sha-ca585b7fe40cb423d1c5d2f32eb8930ee9558949
TESTAGRAM_FEDERATION_IMAGE=ghcr.io/trendyzima/testagram-federation:sha-8aa46c04532eab99d533709109c7f86d716cff36
ALGORITHM_INTERNAL_TOKEN=REPLACE_WITH_SHARED_RANDOM_32_BYTE_RANKER_TOKEN
FEDERATION_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_BACKEND_TO_FEDERATION_TOKEN
FEDERATION_BACKEND_INTERNAL_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_32_BYTE_FEDERATION_TO_BACKEND_TOKEN
FEDERATION_DATABASE_NAME=testagram_federation
FEDERATION_DATABASE_URL=postgresql://testagram:REPLACE_WITH_SAME_BACKEND_POSTGRES_PASSWORD@federation-db:5432/testagram_federation?sslmode=disable
FEDERATION_PUBLIC_BASE_URL=https://federation.testagram.site
FEDERATION_INSTANCE_DOMAIN=testagram.site
FEDERATION_SERVICE_ACTOR_USERNAME=testagram
FEDERATION_DELIVERY_WORKER_ENABLED=false
FEDERATION_OUTBOX_POLLER_ENABLED=false
FEDERATION_INBOX_WORKER_ENABLED=false

# Appwrite validates client session JWTs for video and notification APIs.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=REPLACE_WITH_APPWRITE_PROJECT_ID

VIDEO_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
VIDEO_ACCOUNT_QUOTA_BYTES=21474836480
VIDEO_MIN_FREE_BYTES=2147483648

NOTIFICATION_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET
PLATFORM_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET

# Persistent media root shared by the video API and worker.
TESTAGRAM_STORAGE_ROOT=/var/lib/testagram/storage
