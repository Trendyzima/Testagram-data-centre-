# Copy the POSTGRES_PASSWORD value from the Backend self-hosted .env.
# The Backend Compose stack creates the stable testagram-platform network first.
DATABASE_URL=postgresql://testagram:REPLACE_WITH_SAME_BACKEND_POSTGRES_PASSWORD@postgres:5432/testagram?sslmode=disable
TESTAGRAM_NETWORK=testagram-platform
TESTAGRAM_EGRESS_NETWORK=testagram-egress

# Appwrite validates client session JWTs for video and notification APIs.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=REPLACE_WITH_APPWRITE_PROJECT_ID

VIDEO_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
VIDEO_ACCOUNT_QUOTA_BYTES=21474836480
VIDEO_MIN_FREE_BYTES=2147483648

NOTIFICATION_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET

# Persistent media root shared by the video API and worker.
TESTAGRAM_STORAGE_ROOT=/var/lib/testagram/storage
