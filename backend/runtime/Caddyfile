{
  email {$TLS_ADMIN_EMAIL}
}

:80 {
  respond "Testagram edge requires HTTPS" 421
}

{$TESTAGRAM_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 20GB
  }
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
  }

  handle /v1/videos* {
    reverse_proxy video:8790
  }

  handle /v1/channels* {
    reverse_proxy video:8790
  }

  handle {
    reverse_proxy {$TESTAGRAM_ORIGIN}
  }
}
