{
  email {$TLS_ADMIN_EMAIL}
}

:80 {
  respond "Testagram edge requires HTTPS" 421
}

{$TESTAGRAM_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 20GB
  }
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
  }

  handle /auth/* {
    reverse_proxy api-gw:8000
  }

  handle /rest/* {
    reverse_proxy api-gw:8000
  }

  handle /storage/* {
    reverse_proxy api-gw:8000
  }

  handle /realtime/* {
    reverse_proxy api-gw:8000
  }

  handle /functions/* {
    reverse_proxy api-gw:8000
  }

  handle /graphql/* {
    reverse_proxy api-gw:8000
  }

  handle /pg/* {
    reverse_proxy api-gw:8000
  }

  handle /.well-known/* {
    reverse_proxy api-gw:8000
  }

  handle /v1/config/* {
    reverse_proxy platform:8095
  }

  handle /v1/videos* {
    reverse_proxy video:8790
  }

  handle /v1/channels* {
    reverse_proxy video:8790
  }

  handle /v1/feed {
    reverse_proxy video:8790
  }

  handle {
    reverse_proxy {$TESTAGRAM_ORIGIN}
  }
}

