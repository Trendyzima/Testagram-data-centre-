{
  email {$TLS_ADMIN_EMAIL}
  on_demand_tls {
    ask http://control-plane:8787/v1/hosting/tls/authorize
  }
}

:80 {
  redir https://{host}{uri} permanent
}

{$TESTAGRAM_API_DOMAIN:api.testagram.site} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
  }
  handle {
    request_body {
      max_size 20MB
    }
    reverse_proxy api:8080
  }
}

{$TESTAGRAM_DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
  }

  handle /auth/* {
    request_body {
      max_size 10MB
    }
    reverse_proxy api-gw:8000
  }

  handle /rest/* {
    request_body {
      max_size 10MB
    }
    reverse_proxy api-gw:8000
  }

  handle /storage/* {
    # Object uploads may be large; keep this allowance scoped to storage only.
    request_body {
      max_size 20GB
    }
    reverse_proxy api-gw:8000
  }

  handle /realtime/* {
    request_body {
      max_size 10MB
    }
    reverse_proxy api-gw:8000
  }

  handle /functions/* {
    request_body {
      max_size 10MB
    }
    reverse_proxy api-gw:8000
  }

  handle /graphql/* {
    request_body {
      max_size 10MB
    }
    reverse_proxy api-gw:8000
  }

  handle /pg/* {
    request_body {
      max_size 10MB
    }
    reverse_proxy api-gw:8000
  }

  handle /.well-known/* {
    request_body {
      max_size 10MB
    }
    reverse_proxy api-gw:8000
  }

  handle /v1/config/* {
    request_body {
      max_size 10MB
    }
    reverse_proxy platform:8095
  }

  handle /v1/videos {
    # The upload endpoint is the only video route that accepts large bodies.
    request_body {
      max_size 20GB
    }
    reverse_proxy video:8790
  }

  handle /v1/videos/* {
    request_body {
      max_size 10MB
    }
    reverse_proxy video:8790
  }

  handle /v1/channels* {
    request_body {
      max_size 10MB
    }
    reverse_proxy video:8790
  }

  handle /v1/feed {
    request_body {
      max_size 10MB
    }
    reverse_proxy video:8790
  }

  handle {
    request_body {
      max_size 10MB
    }
    reverse_proxy {$TESTAGRAM_ORIGIN}
  }
}


# Catch-all for Testagram-managed tenant subdomains. The control plane only
# authorizes hostnames that were DNS-verified and activated by an operator.
# Caddy obtains per-host certificates on demand; the ask endpoint prevents
# arbitrary hostname certificate issuance.
https:// {
  tls {
    on_demand
  }
  encode zstd gzip
  request_body {
    max_size 100MB
  }
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
  }
  reverse_proxy control-plane:8787
}
