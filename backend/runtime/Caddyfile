{
  email {$TLS_ADMIN_EMAIL}
}

:80 {
  respond "Testagram edge requires HTTPS" 421
}

{$TESTAGRAM_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 2GB
  }
  rate_limit {
    zone api {
      key {remote_host}
      events 120
      window 1m
    }
  }
  reverse_proxy {$TESTAGRAM_ORIGIN}
}
