# Canonical Testagram VPS runtime.
# Pin every published image to an immutable digest before deployment.
TESTAGRAM_BACKEND_IMAGE=ghcr.io/trendyzima/testagram-backend@sha256:REPLACE_WITH_64_HEX_DIGEST
TESTAGRAM_ALGORITHM_IMAGE=
CADDY_IMAGE=caddy:2.10-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_CLIENT_IMAGE=postgres:17-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
TLS_ADMIN_EMAIL=ops@example.com

# Canonical Testagram product database (contains native identity and TV catalogue data).
# Quote connection URLs when query strings contain shell metacharacters such as ampersands; install.sh sources this file.
DATABASE_URL="postgresql://testagram:REPLACE_PASSWORD@db.example.invalid/testagram?sslmode=require&channel_binding=require"
DB_MAX_CONNS=10
TESTAGRAM_AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_PUBLIC_BASE_URL=https://testagram.site
ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site

# Optional private ranking. Keep empty/disabled until its image and token are provisioned.
ALGORITHM_URL=
ALGORITHM_INTERNAL_TOKEN=

# Optional Federation. These are distinct credentials for each direction.
TESTAGRAM_FEDERATION_IMAGE=
FEDERATION_PUBLIC_BASE_URL=https://testagram.site
FEDERATION_DATABASE_URL=
FEDERATION_BACKEND_INTERNAL_TOKEN=
FEDERATION_INTERNAL_URL=
FEDERATION_INTERNAL_TOKEN=
FEDERATION_INGRESS_TOKEN=
FEDERATION_DELIVERY_WORKER_ENABLED=false
FEDERATION_OUTBOX_POLLER_ENABLED=false
FEDERATION_INBOX_WORKER_ENABLED=false

# Backend-to-Data-Centre media bridge. Keep disabled until end-to-end media acceptance passes.
FRESH_MEDIA_ENABLED=false
DATA_CENTRE_MEDIA_API_URL=
FRESH_DATA_CENTRE_INTERNAL_TOKEN=
# Separate Backend-to-Data-Centre identity-evidence trust token; never reuse FRESH_DATA_CENTRE_INTERNAL_TOKEN.
IDENTITY_EVIDENCE_DATA_CENTRE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_IDENTITY_EVIDENCE_TOKEN
FRESH_MEDIA_PRIMARY_PROVIDER=b2
TESTAGRAM_STORAGE_POOL_BYTES=150000000000
TESTAGRAM_STORAGE_PER_USER_BYTES=2147483648

# B2 and R2 credentials are consumed only by the Data Centre media service.
MEDIA_DATABASE_URL=
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_S3_REGION=us-east-005
B2_S3_BUCKET=
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=
# Separate Backblaze application key restricted to the dedicated private identity bucket.
B2_S3_IDENTITY_EVIDENCE_PRIVATE_BUCKET=
B2_S3_IDENTITY_EVIDENCE_ACCESS_KEY_ID=
B2_S3_IDENTITY_EVIDENCE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_METADATA_BUCKET=

# VPS MinIO stores the primary media metadata copy; keep its credentials separate.
VPS_MINIO_ENDPOINT=http://object-storage:9000
VPS_MINIO_REGION=us-east-1
VPS_MINIO_METADATA_BUCKET=testagram-media-metadata
VPS_MINIO_METADATA_ACCESS_KEY_ID=
VPS_MINIO_METADATA_SECRET_ACCESS_KEY=

CLOUDFLARE_MEDIA_BASE_URL=
CLOUDFLARE_MEDIA_SIGNING_SECRET=

# Optional CDN integration. Configure only after the CDN origin and purge contract are deployed.
CDN_MEDIA_ASSERTION_SECRET=
CDN_MEDIA_BASE_URL=
CDN_ORIGIN_AUTH_TOKEN=
CDN_PURGE_URL=
CDN_PURGE_TOKEN=

# Native-auth email delivery. Keep secrets in the VPS-local 0600 env file.
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
AUTH_FROM_EMAIL=
TESTAGRAM_MAIL_ENCRYPTION_KEY=

# Independent cold archive; never pass these credentials to the Backend API.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Dedicated Data Centre infrastructure database and node control-plane.
DATA_CENTRE_DATABASE_URL=
VPS_INTERNAL_TOKEN=
VPS_NODE_BOOTSTRAP_TOKEN=
TESTAGRAM_BASE_DOMAIN=
TESTAGRAM_DOMAIN_TARGETS=
TESTAGRAM_PUBLIC_DNS_TARGET=
TESTAGRAM_PUBLIC_ORIGIN_IP=

# Destructive lifecycle remains disabled.
TESTAGRAM_RETENTION_ENABLED=false
TESTAGRAM_RETENTION_DRY_RUN=true

# Optional authenticated watchdog activation; disabled until separately accepted.
VPS_WATCHDOG_INTERNAL_TOKEN=
VPS_ENABLE_WATCHDOG_ACTIVATION=false
VPS_WATCHDOG_DATA_CENTRE_COMPOSE_FILE=/opt/testagram/vps/docker-compose.yml
VPS_WATCHDOG_CDN_COMPOSE_FILE=/opt/testagram/cdn/docker-compose.yml
