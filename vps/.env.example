# Testagram Data Centre runtime only.
# The canonical Go API, public HTTPS edge and staff console are deployed by
# Trendyzima/Testagram-backend-; this file configures Data Centre services.
# Keep this file root-owned and mode 0600. Never commit real credentials.

# Required for the Data Centre node control plane.
DATA_CENTRE_DATABASE_URL=postgresql://testagram:REPLACE_PASSWORD@db.example.invalid/data_centre?sslmode=require
VPS_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET
VPS_NODE_BOOTSTRAP_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_32_BYTE_SECRET
TESTAGRAM_BASE_DOMAIN=testagram.site
TESTAGRAM_DOMAIN_TARGETS=
TESTAGRAM_PUBLIC_DNS_TARGET=
TESTAGRAM_PUBLIC_ORIGIN_IP=

# Optional ranking profile (--profile ranking).
TESTAGRAM_ALGORITHM_IMAGE=ghcr.io/trendyzima/testagram-feed@sha256:REPLACE_WITH_64_HEX_DIGEST
ALGORITHM_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET

# Optional ActivityPub federation profile (--profile federation).
TESTAGRAM_FEDERATION_IMAGE=ghcr.io/trendyzima/testagram-federation@sha256:REPLACE_WITH_64_HEX_DIGEST
FEDERATION_POSTGRES_IMAGE=postgres:17-alpine
FEDERATION_DATABASE_URL=postgresql://testagram:REPLACE_PASSWORD@db.example.invalid/federation?sslmode=require
FEDERATION_DB_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_SECRET
FEDERATION_BACKEND_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET
FEDERATION_INGRESS_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_32_BYTE_SECRET
FEDERATION_PUBLIC_BASE_URL=https://testagram.site
FEDERATION_DELIVERY_WORKER_ENABLED=false
FEDERATION_OUTBOX_POLLER_ENABLED=false
FEDERATION_INBOX_WORKER_ENABLED=false

# Optional private media profile (--profile media).
# Credentials are delivered only to the Data Centre media service.
POSTGRES_CLIENT_IMAGE=postgres:17-alpine
MEDIA_DATABASE_URL=postgresql://testagram:REPLACE_PASSWORD@db.example.invalid/media?sslmode=require
FRESH_DATA_CENTRE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_S3_REGION=us-east-005
B2_S3_BUCKET=
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=testagram-media
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Optional cold archive configuration; independent of active B2/R2 media.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Destructive lifecycle operations remain disabled.
TESTAGRAM_RETENTION_ENABLED=false
TESTAGRAM_RETENTION_DRY_RUN=true

# User-activity-triggered activation is opt-in and requires a trusted Linux node.
VPS_ENABLE_WATCHDOG_ACTIVATION=false
VPS_WATCHDOG_INTERNAL_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_32_BYTE_SECRET
VPS_WATCHDOG_DATA_CENTRE_COMPOSE_FILE=/opt/testagram/vps/docker-compose.yml
VPS_WATCHDOG_CDN_COMPOSE_FILE=/opt/testagram/cdn/docker-compose.yml
