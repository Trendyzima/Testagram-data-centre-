# Fresh Testagram runtime only; legacy hosted-provider settings are not used.
# Pin the required Backend/Caddy images to immutable digests before deployment. Optional profiles may remain unset.
TESTAGRAM_FRESH_BACKEND_IMAGE=ghcr.io/trendyzima/testagram-backend-fresh@sha256:REPLACE_WITH_64_HEX_DIGEST
TESTAGRAM_ALGORITHM_IMAGE=
CADDY_IMAGE=caddy:2.10-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_CLIENT_IMAGE=postgres:17-alpine
TLS_ADMIN_EMAIL=ops@example.com

FRESH_API_ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1 # Must match the Appwrite project's actual region
APPWRITE_PROJECT_ID= # Set the actual Appwrite project ID; do not use the database ID
APPWRITE_DATABASE_ID=6af01f05003503d9d603
# Dedicated server-only key: users.read, documentsdb.documents.read/write,
# documentsdb.collections.read and documentsdb.indexes.read for readiness checks.
# Keep the secret only in Render/host secret storage; never commit it.
APPWRITE_SERVER_API_KEY=
NEON_# Persistent Testagram-native HS256 signing secret; keep stable across deploys and backups.
TESTAGRAM_AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
DATABASE_URL=postgresql://testagram:REPLACE_PASSWORD@ep-example.neon.tech/testagram?sslmode=require&channel_binding=require
NEON_REQUIRED=true
# Shared with the trusted identity approval issuer; never expose to clients.
IDENTITY_PREAUTH_SECRET=

ALGORITHM_INTERNAL_TOKEN=

# Optional private Federation runtime. Enable with --profile federation after provisioning its dedicated Neon database and service token.
TESTAGRAM_FEDERATION_IMAGE=
FEDERATION_POSTGRES_IMAGE=postgres:17-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
FEDERATION_PUBLIC_BASE_URL=https://testagram.site
FEDERATION_DATABASE_URL=
FEDERATION_DB_PASSWORD=
FRESH_FEDERATION_INTERNAL_TOKEN=
FEDERATION_DELIVERY_WORKER_ENABLED=false
FEDERATION_OUTBOX_POLLER_ENABLED=false
FEDERATION_INBOX_WORKER_ENABLED=false

# Publishing remains fail-closed until Testagram-owned moderation is implemented and enabled.
FRESH_MEDIA_ENABLED=false
FRESH_MEDIA_PRIMARY_PROVIDER=b2
TESTAGRAM_STORAGE_POOL_BYTES=150000000000
TESTAGRAM_STORAGE_PER_USER_BYTES=2147483648

# Configure B2 and R2 before enabling media. Keep media disabled until both
# providers and the Appwrite metadata collections/indexes are verified.
# Appwrite stores identity/application metadata only; media bytes stay in B2/R2/VPS.
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_S3_REGION=us-east-005
B2_S3_BUCKET=audiostrendy
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://77dbe7a859196105dc84fbb6b7094019.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=testagram-media
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_MEDIA_BASE_URL=https://media.testagram.site
CLOUDFLARE_MEDIA_SIGNING_SECRET=

# Independent cold archive; not the same bucket/provider as active media.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Optional Data Centre node control-plane. Enable with --profile nodes after provisioning its own TLS PostgreSQL database and service tokens.
DATA_CENTRE_DATABASE_URL=
VPS_INTERNAL_TOKEN=
VPS_NODE_BOOTSTRAP_TOKEN=
TESTAGRAM_BASE_DOMAIN=
TESTAGRAM_DOMAIN_TARGETS=
TESTAGRAM_PUBLIC_DNS_TARGET=
TESTAGRAM_PUBLIC_ORIGIN_IP=

# Destructive lifecycle remains disabled regardless of media settings.
TESTAGRAM_RETENTION_ENABLED=false
TESTAGRAM_RETENTION_DRY_RUN=true

# Optional authenticated-user impulse activation; disabled until the Backend
# and this control plane share the dedicated token and the host has both stacks.
VPS_WATCHDOG_INTERNAL_TOKEN=
VPS_ENABLE_WATCHDOG_ACTIVATION=false
VPS_WATCHDOG_DATA_CENTRE_COMPOSE_FILE=/opt/testagram/vps/docker-compose.yml
VPS_WATCHDOG_CDN_COMPOSE_FILE=/opt/testagram/cdn/docker-compose.yml
