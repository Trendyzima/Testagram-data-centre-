# Fresh Testagram runtime: Appwrite identity, Neon product data, private services and B2/R2 media.
# Pin every image to an immutable digest before deployment.
TESTAGRAM_FRESH_BACKEND_IMAGE=ghcr.io/trendyzima/testagram-backend-fresh@sha256:REPLACE_WITH_64_HEX_DIGEST
TESTAGRAM_ALGORITHM_IMAGE=ghcr.io/trendyzima/testagram-feed@sha256:REPLACE_WITH_64_HEX_DIGEST
CADDY_IMAGE=caddy:2.10-alpine
POSTGRES_CLIENT_IMAGE=postgres:17-alpine
TLS_ADMIN_EMAIL=ops@example.com

FRESH_API_ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_SERVER_API_KEY=
# Shared with the trusted identity approval issuer; never expose to XClone.
IDENTITY_PREAUTH_SECRET=

ALGORITHM_INTERNAL_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Private Federation runtime. Use a distinct database and random password.
TESTAGRAM_FEDERATION_IMAGE=ghcr.io/trendyzima/testagram-federation@sha256:REPLACE_WITH_64_HEX_DIGEST
FEDERATION_POSTGRES_IMAGE=postgres:17-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
FEDERATION_DB_PASSWORD=REPLACE_WITH_64_HEX_RANDOM_CHARACTERS
FRESH_FEDERATION_INTERNAL_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FEDERATION_OUTBOX_POLLER_ENABLED=false
FEDERATION_DELIVERY_WORKER_ENABLED=false

# Fresh post moderation. Backend refuses post writes if the provider key is missing.
ONSPACE_AI_BASE_URL=https://ai.onspace.ai/v1
ONSPACE_AI_API_KEY=
FRESH_MEDIA_ENABLED=false
TESTAGRAM_STORAGE_POOL_BYTES=150000000000
TESTAGRAM_STORAGE_PER_USER_BYTES=2147483648

# Configure B2 and R2 before enabling media. Keep media disabled until both
# providers and the Appwrite storage collections/indexes are verified.
B2_S3_ENDPOINT=
B2_S3_REGION=us-west-004
B2_S3_BUCKET=
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Independent cold archive; not the same bucket/provider as active media.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Data Centre infrastructure state uses its own TLS PostgreSQL database.
DATA_CENTRE_DATABASE_URL=postgresql://testagram:REPLACE_PASSWORD@ep-example.neon.tech/data_centre?sslmode=require&channel_binding=require
VPS_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_SECRET
VPS_NODE_BOOTSTRAP_TOKEN=REPLACE_WITH_RANDOM_SECRET
TESTAGRAM_BASE_DOMAIN=
TESTAGRAM_DOMAIN_TARGETS=
TESTAGRAM_PUBLIC_DNS_TARGET=
TESTAGRAM_PUBLIC_ORIGIN_IP=

# Destructive lifecycle remains disabled regardless of media settings.
TESTAGRAM_RETENTION_ENABLED=false
TESTAGRAM_RETENTION_DRY_RUN=true

# Encrypted Data Centre backup destination and age public recipient.
TESTAGRAM_BACKUP_REMOTE=user@backup-host:/srv/testagram-backups
TESTAGRAM_BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_OFF_HOST_RECIPIENT
TESTAGRAM_STORAGE_ROOT=/var/lib/testagram/storage

# Private Backend -> Data Centre media control-plane. Keep disabled until the
# four B2/R2 buckets, checksums, and staging upload/replica/download tests pass.
FRESH_DATA_CENTRE_INTERNAL_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MEDIA_STORAGE_ENABLED=false
B2_S3_PRIVATE_BUCKET=testagram-private-media
B2_S3_PUBLIC_BUCKET=testagram-public-media
CLOUDFLARE_R2_PRIVATE_BUCKET=testagram-r2-private-media
CLOUDFLARE_R2_PUBLIC_BUCKET=testagram-r2-public-media
B2_S3_SIGNING_HOST=
CLOUDFLARE_R2_SIGNING_HOST=
MEDIA_MAX_IMAGE_BYTES=26214400
MEDIA_MAX_VIDEO_BYTES=524288000
MEDIA_UPLOAD_URL_TTL=15m
MEDIA_DOWNLOAD_URL_TTL=10m
