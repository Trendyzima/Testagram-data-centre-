TESTAGRAM_ROOT=/opt/testagram
SUPABASE_DATA_ROOT=/var/lib/testagram/supabase
TESTAGRAM_STORAGE_ROOT=/var/lib/testagram/storage
SUPABASE_NETWORK=testagram-supabase
TESTAGRAM_DOMAIN=api.example.com
SUPABASE_PUBLIC_URL=https://api.example.com
SUPABASE_API_EXTERNAL_URL=https://api.example.com/auth/v1
SUPABASE_STUDIO_DOMAIN=studio.example.com
TLS_ADMIN_EMAIL=admin@example.com
POSTGRES_PASSWORD=CHANGE_ME_LONG_ALPHANUMERIC
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ANON_KEY=CHANGE_ME_SIGNED_SUPABASE_ANON_JWT
SERVICE_ROLE_KEY=CHANGE_ME_SIGNED_SUPABASE_SERVICE_ROLE_JWT
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_LONG_RANDOM
VPS_INTERNAL_TOKEN=CHANGE_ME_RANDOM
VPS_NODE_BOOTSTRAP_TOKEN=CHANGE_ME_RANDOM
VIDEO_JWT_SECRET=${JWT_SECRET}
VIDEO_SIGNING_SECRET=CHANGE_ME_RANDOM_32_BYTE_SECRET
NOTIFICATION_JWT_SECRET=${JWT_SECRET}
NOTIFICATION_INTERNAL_TOKEN=CHANGE_ME_RANDOM_32_BYTE_SECRET
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/postgres
