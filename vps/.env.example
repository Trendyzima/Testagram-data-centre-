TESTAGRAM_ROOT=/opt/testagram
SUPABASE_DATA_ROOT=/var/lib/testagram/supabase
TESTAGRAM_STORAGE_ROOT=/var/lib/testagram/storage
# Optional native-host ownership for the managed storage tree.
# TESTAGRAM_STORAGE_OWNER=testagram
# TESTAGRAM_STORAGE_GROUP=testagram
SUPABASE_NETWORK=testagram-supabase
TESTAGRAM_DOMAIN=api.example.com
TESTAGRAM_ORIGIN=https://testagram.site
SUPABASE_PUBLIC_URL=https://api.example.com
SUPABASE_API_EXTERNAL_URL=https://api.example.com/auth/v1
SITE_URL=https://api.example.com
TLS_ADMIN_EMAIL=admin@example.com
POSTGRES_PASSWORD=CHANGE_ME_LONG_ALPHANUMERIC
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ANON_KEY=CHANGE_ME_SIGNED_SUPABASE_ANON_JWT
SERVICE_ROLE_KEY=CHANGE_ME_SIGNED_SUPABASE_SERVICE_ROLE_JWT
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_LONG_RANDOM
VPS_INTERNAL_TOKEN=CHANGE_ME_RANDOM
VPS_NODE_BOOTSTRAP_TOKEN=CHANGE_ME_RANDOM
# Comma-separated exact image@sha256:digest references permitted on execution nodes.
# Keep empty until you have reviewed and pinned the images you intend to run.
VPS_ALLOWED_WORKLOAD_IMAGES=
# Optional hosting control plane. Set only to a domain you control.
# TESTAGRAM_BASE_DOMAIN=testagram.site
# Allowlist target service names and private origins; comma-separated, no credentials or query strings.
# TESTAGRAM_DOMAIN_TARGETS=web=http://frontend:3000,media=http://video:8790
# Optional target used in DNS desired-state exports; it is not applied automatically.
# TESTAGRAM_PUBLIC_DNS_TARGET=edge.testagram.site
# Set to the public IPv4/IPv6 address the new subdomains must resolve to before activation.
# TESTAGRAM_PUBLIC_ORIGIN_IP=203.0.113.10
VIDEO_JWT_SECRET=${JWT_SECRET}
VIDEO_SIGNING_SECRET=CHANGE_ME_RANDOM_32_BYTE_SECRET
# Video-only quota per account (20 GiB); leave at least 2 GiB free on the media filesystem.
VIDEO_ACCOUNT_QUOTA_BYTES=21474836480
VIDEO_MIN_FREE_BYTES=2147483648
NOTIFICATION_JWT_SECRET=${JWT_SECRET}
NOTIFICATION_INTERNAL_TOKEN=CHANGE_ME_RANDOM_32_BYTE_SECRET
PLATFORM_INTERNAL_TOKEN=CHANGE_ME_RANDOM_32_BYTE_SECRET
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/postgres
# Canonical Testagram identity/social database (Neon PostgreSQL); TLS is mandatory.
TESTAGRAM_DATABASE_URL=postgresql://testagram:REPLACE_WITH_NEON_PASSWORD@ep-example-000000.us-east-1.aws.neon.tech/testagram?sslmode=require&channel_binding=require

# Single public application API. Point XClone VITE_TESTAGRAM_API_URL here.
TESTAGRAM_API_DOMAIN=api.testagram.site
TESTAGRAM_BACKEND_IMAGE=ghcr.io/trendyzima/testagram-backend@sha256:REPLACE_WITH_64_HEX_DIGEST
TESTAGRAM_ALGORITHM_IMAGE=ghcr.io/trendyzima/testagram-feed@sha256:REPLACE_WITH_64_HEX_DIGEST
# Keep unset while federation is disabled. If preview is explicitly enabled, pin a reviewed digest.
# TESTAGRAM_FEDERATION_IMAGE=ghcr.io/trendyzima/testagram-federation@sha256:REPLACE_WITH_64_HEX_DIGEST
TESTAGRAM_AUTH_PROVIDER=supabase
# Keep the production cutover gate enabled until XClone and every legacy data path
# have completed the coordinated Appwrite session migration.
TESTAGRAM_REQUIRE_APPWRITE=1
ALGORITHM_INTERNAL_TOKEN=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site
SUPABASE_INTERNAL_URL=http://api-gw:8000
APPWRITE_ENDPOINT=https://REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=REPLACE_WITH_APPWRITE_PROJECT_ID
# Server-only secret shared with the trusted identity-verification worker; never expose to Vite.
APPWRITE_IDENTITY_INGEST_TOKEN=CHANGE_ME_RANDOM_32_BYTE_SECRET
# Keep false until the KYC Edge Function is deployed with matching secrets and legacy inventory is reconciled.
APPWRITE_KYC_BINDING_ENABLED=false
# Keep Supabase selected until the XClone global Appwrite session migration and staging checks pass.
DB_MAX_CONNS=10
MEDIA_S3_ENDPOINT=
MEDIA_S3_SIGNING_HOST=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_REGION=us-east-1
MEDIA_PRIVATE_BUCKET=testagram-private-media
MEDIA_PUBLIC_BUCKET=testagram-public-media
MEDIA_PUBLIC_BASE_URL=https://media.testagram.site/v1
FEDERATION_PUBLIC_BASE_URL=https://federation.testagram.site
FEDERATION_INSTANCE_DOMAIN=testagram.site
FEDERATION_SERVICE_ACTOR_USERNAME=testagram
FEDERATION_SERVICE_ACTOR_NAME=Testagram

# Keep local PostgreSQL product writes disabled until identity linking and legacy-content migration are accepted.
TESTAGRAM_LOCAL_PRODUCT_WRITES_ENABLED=false
