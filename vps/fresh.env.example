# Fresh Testagram runtime configuration. Keep this file private.
# The default profile starts the public Appwrite login/API edge. Ranking, Federation and node control-plane are opt-in profiles.
# Pin every enabled production image to an immutable digest before deployment.
TESTAGRAM_FRESH_BACKEND_IMAGE=ghcr.io/trendyzima/testagram-backend-fresh@sha256:REPLACE_WITH_64_HEX_DIGEST
TESTAGRAM_ALGORITHM_IMAGE=
TESTAGRAM_ENABLE_RANKING=false
CADDY_IMAGE=caddy:2.10-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_CLIENT_IMAGE=
TLS_ADMIN_EMAIL=ops@example.com

FRESH_API_ALLOWED_ORIGINS=https://testagram.site,https://www.testagram.site
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_SERVER_API_KEY=

# Backend social data-plane connection. Appwrite login can start independently;
# /readyz/platform remains unavailable until Neon schema, canonical repositories,
# migration reconciliation and cutover are complete. Keep this required for release gating.
NEON_DATABASE_URL=postgresql://TESTAGRAM_ROLE:REPLACE_PASSWORD@ep-example-pooler.neon.tech/testagram?sslmode=require&connect_timeout=5
NEON_REQUIRED=true

ALGORITHM_ENDPOINT=
ALGORITHM_INTERNAL_TOKEN=
# Optional: configure the endpoint and a 32+ character token to enable private ranking.

# Private Federation runtime. Use a distinct database and random password.
TESTAGRAM_FEDERATION_IMAGE=
TESTAGRAM_ENABLE_FEDERATION=false
# Dedicated Neon pooled endpoint for Federation protocol state. Provision the DB/role and migrate state before production cutover.
FEDERATION_DATABASE_URL=
FEDERATION_BACKEND_INTERNAL_URL=
FEDERATION_POSTGRES_IMAGE=postgres:17-alpine # local-only profile image
FEDERATION_DB_PASSWORD=
FRESH_FEDERATION_INTERNAL_TOKEN=
# Optional: set this same 32+ character secret in Backend and Federation to enable private federation APIs.

# Fresh post moderation. Backend refuses post writes if the provider key is missing.
ONSPACE_AI_BASE_URL=https://ai.onspace.ai/v1
ONSPACE_AI_API_KEY=
FRESH_MEDIA_ENABLED=false
TESTAGRAM_STORAGE_POOL_BYTES=150000000000
TESTAGRAM_STORAGE_PER_USER_BYTES=2147483648

# Backblaze B2 is the durable primary object store; Cloudflare R2 is the
# delivery/replica object store. Backend performs signed object operations,
# provider replica verification and private URL signing; Data Centre manages nodes and recovery.
# Keep media disabled until provider credentials, Appwrite metadata collections,
# object checksums, replica reconciliation and restore tests are verified.
B2_S3_ENDPOINT=
B2_S3_REGION=us-west-004
B2_S3_BUCKET=
B2_S3_ACCESS_KEY_ID=
B2_S3_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional Cloudflare private-media Worker origin and HMAC secret. Set both or neither.
CLOUDFLARE_MEDIA_BASE_URL=
CLOUDFLARE_MEDIA_SIGNING_SECRET=

# Independent cold archive; not the same bucket/provider as active media.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# Optional Android/Linux node control-plane. Enable only after its separate database and secrets are provisioned.
TESTAGRAM_ENABLE_NODES=false
DATA_CENTRE_DATABASE_URL=
VPS_INTERNAL_TOKEN=
VPS_NODE_BOOTSTRAP_TOKEN=
TESTAGRAM_BASE_DOMAIN=
TESTAGRAM_DOMAIN_TARGETS=
TESTAGRAM_PUBLIC_DNS_TARGET=
TESTAGRAM_PUBLIC_ORIGIN_IP=

# Destructive lifecycle remains disabled regardless of media settings.
TESTAGRAM_RETENTION_ENABLED=false
TESTAGRAM_RETENTION_DRY_RUN=true
