[Unit]
Description=Testagram VPS node agent
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/testagram/node-agent.env
ExecStart=/opt/testagram/bin/node-agent
Restart=on-failure
RestartSec=5s
ExecStartPre=/usr/bin/install -d -m 0700 /srv/testagram-media
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/testagram/storage/nodes
ReadWritePaths=/srv/testagram-media
ReadWritePaths=/opt/testagram
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
